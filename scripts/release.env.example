# Lokale Einstellungen für "./scripts/build-app.sh release".
# Kopieren nach scripts/release.env (wird nicht eingecheckt) und anpassen.
# Eine bereits gesetzte Umgebungsvariable hat Vorrang vor dieser Datei.

# Name des notarytool-Keychain-Profils. Einmalig anlegen mit:
#   xcrun notarytool store-credentials devwatch \
#       --apple-id <deine-apple-id> --team-id <TEAMID>
# Das dabei abgefragte Passwort ist ein app-spezifisches Passwort von
# appleid.apple.com, nicht das Apple-ID-Passwort selbst.
NOTARY_PROFILE=devwatch

# Signaturidentität. Ohne Angabe nimmt das Script die erste
# "Developer ID Application" aus dem Schlüsselbund:
#   security find-identity -v -p codesigning
# SIGN_IDENTITY=Developer ID Application: Vorname Nachname (TEAMID)

# Auf 1 setzen, um nur zu signieren und das DMG zu bauen, ohne Notarisierung.
# Das Ergebnis ist dann nicht zur Weitergabe geeignet.
# SKIP_NOTARIZE=0
