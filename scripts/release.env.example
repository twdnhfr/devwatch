# Local settings for "./scripts/build-app.sh release".
# Copy to scripts/release.env (excluded from version control) and customize.
# An existing environment variable takes precedence over this file.

# Name of the notarytool keychain profile. Create it once with:
#   xcrun notarytool store-credentials devwatch \
#       --apple-id <your-apple-id> --team-id <TEAMID>
# The password requested by this command is an app-specific Apple password,
# not your Apple Account password.
NOTARY_PROFILE=devwatch

# Signing identity. If omitted, the script uses the first
# "Developer ID Application" identity in the keychain:
#   security find-identity -v -p codesigning
# SIGN_IDENTITY=Developer ID Application: Firstname Lastname (TEAMID)

# Set to 1 to sign and build the DMG without notarization.
# The result is not suitable for distribution.
# SKIP_NOTARIZE=0
